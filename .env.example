# Backend
DATABASE_URL=postgresql://sfl:sfl@127.0.0.1:5434/sfl
JWT_SECRET=dev-sfl-jwt-secret-change-me-32chars!!
PORT=4006
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
PUBLIC_API_URL=http://127.0.0.1:4006
UPLOAD_DIR=./data/uploads
CRON_SECRET=dev-cron-secret
# Seed Master (local only — never commit real production password)
SEED_ADMIN_USER=master
SEED_ADMIN_PASSWORD=change-me

# Mensalidades Asaas. Sem as três variáveis a tela existe, mas não cobra.
# Nunca commite a chave. ASAAS_ENV: sandbox | production
# ASAAS_API_KEY=
# ASAAS_WEBHOOK_TOKEN=
# ASAAS_ENV=sandbox

# Optional Google OAuth (frontend login)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
