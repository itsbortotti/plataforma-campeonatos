# Backend
DATABASE_URL=postgresql://sfl:sfl@127.0.0.1:5434/sfl
JWT_SECRET=dev-sfl-jwt-secret-change-me-32chars!!
PORT=4006
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
PUBLIC_API_URL=http://127.0.0.1:4006
UPLOAD_DIR=./data/uploads
CRON_SECRET=dev-cron-secret
# Seed Master. Obrigatória, só no ambiente — nunca commite o valor.
# No Render, troque SEED_ADMIN_PASSWORD (a senha antiga ficou no histórico do Git) e redeploy.
# Mínimo 12 caracteres, com letras e números. O seed falha se estiver vazia ou fraca.
SEED_ADMIN_USER=master
SEED_ADMIN_PASSWORD=

# Optional Google OAuth (frontend login)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=http://127.0.0.1:4006/api/auth/google/callback

# Frontend
NEXT_PUBLIC_API_URL=http://127.0.0.1:4006
