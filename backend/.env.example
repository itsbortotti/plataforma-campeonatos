DATABASE_URL=postgresql://sfl:sfl@127.0.0.1:5434/sfl
JWT_SECRET=dev-sfl-jwt-secret-change-me-32chars!!
PORT=4006
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
PUBLIC_API_URL=http://127.0.0.1:4006
UPLOAD_DIR=./data/uploads
CRON_SECRET=dev-cron-secret
# Só no ambiente. Não commite o valor.
# Cria o admin se ele não existe. Não regrava a senha de quem já existe,
# a menos que SEED_ADMIN_RESET_PASSWORD=true. Senha fraca é logada e não derruba o start.
# Mínimo 12 caracteres, com letras e números.
SEED_ADMIN_USER=master
SEED_ADMIN_PASSWORD=
# SEED_ADMIN_RESET_PASSWORD=false

# Mensalidades Asaas. Sem as três variáveis o recurso fica desligado e o site segue no ar.
# Nunca commite a chave. ASAAS_ENV: sandbox | production
# ASAAS_API_KEY=
# ASAAS_WEBHOOK_TOKEN=
# ASAAS_ENV=sandbox
